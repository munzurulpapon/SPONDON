<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme with NoActionBar for modern custom headers -->
    <style name="Theme.SPONDON" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/primary_blue_dark</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:statusBarColor">@color/primary_blue_dark</item>
    </style>

    <!-- Theme with DarkActionBar if needed by legacy activities -->
    <style name="Theme.SPONDON.DarkActionBar" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/primary_blue</item>
        <item name="colorPrimaryDark">@color/primary_blue_dark</item>
        <item name="colorAccent">@color/accent_cyan</item>
    </style>
</resources>
