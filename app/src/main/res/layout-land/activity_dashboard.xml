<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!-- Left Column: Command & Pulse Quick Actions (Landscape Exclusive) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/primary_blue"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SPONDON"
                    android:textColor="#38BDF8"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Citizen Dashboard"
                    android:textColor="#F1F5F9"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="38dp"
                android:backgroundTint="#EF4444"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Logout"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Khulna Smart City Super App • Citizen Services &amp; Urban Governance"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <!-- Provider Workspace Banner -->
        <LinearLayout
            android:id="@+id/layoutProviderWorkspace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#065F46"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SERVICE PROVIDER WORKSPACE"
                android:textColor="#A7F3D0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnProviderRequests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#10B981"
                android:text="View Client Bookings"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Quick Pulse Action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1E3A8A"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CITY INTELLIGENCE &amp; ANALYTICS"
                android:textColor="#BFDBFE"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCityIntelligence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#3B82F6"
                android:text="Explore City Pulse"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- SOS Action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#B91C1C"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMERGENCY ASSISTANCE (SOS)"
                android:textColor="#FECACA"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnEmergency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="42dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#EF4444"
                android:text="🚨 SOS Emergency Alert"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Right Column: All Civic Modules ScrollView -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.6"
        android:fillViewport="true"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. CIVIC GOVERNANCE &amp; URBAN ISSUES"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="10dp">

                <Button
                    android:id="@+id/btnReportIssue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#2563EB"
                    android:text="Report a City Problem (Photo &amp; GPS)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnMyReports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#3B82F6"
                    android:text="My Civic Reports &amp; Status Tracking"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCityMap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#0D9488"
                    android:text="Explore City Map, GPS &amp; Turn-by-Turn Routing"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPublicProjects"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:backgroundTint="#475569"
                    android:text="Public Infrastructure Projects &amp; Milestones"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Section 2 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="2. SMART SERVICES &amp; CIVIC UTILITIES"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="10dp">

                <Button
                    android:id="@+id/btnServicesDirectory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#4338CA"
                    android:text="Smart City Services Directory [DEMO DATA]"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnMyServiceRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#6366F1"
                    android:text="My Service Bookings &amp; Status"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPublicUtilities"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#0F766E"
                    android:text="Public Utilities: Water (WASA), Power, Waste &amp; Gas"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnVehicleRoad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:backgroundTint="#334155"
                    android:text="Vehicle Workshops, 24/7 Towing &amp; Parking Alerts"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Section 3 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="3. URBAN MOBILITY &amp; TOURISM"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="10dp">

                <Button
                    android:id="@+id/btnTransportation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#0284C7"
                    android:text="Smart Transportation: Buses, Trains &amp; River Ferries"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnTourism"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:backgroundTint="#0D9488"
                    android:text="City Landmarks, Parks &amp; Attractions"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Section 4 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="4. HEALTH, SAFETY &amp; DISASTER RELIEF"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="10dp">

                <Button
                    android:id="@+id/btnHealthcare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#991B1B"
                    android:text="Hospitals, Clinics &amp; 24/7 Pharmacies"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnBloodDonation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#B91C1C"
                    android:text="Blood Donors Directory &amp; Registration"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnDisasterManagement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#DC2626"
                    android:text="Disaster Guidelines &amp; Cyclone Shelters"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnMyEmergencyRequests"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:backgroundTint="#7F1D1D"
                    android:text="My Emergency Requests (Local &amp; Cloud History)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- Section 5 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="5. CITIZEN ENGAGEMENT &amp; REWARDS"
                android:textColor="#0F172A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="10dp">

                <Button
                    android:id="@+id/btnCommunity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#4F46E5"
                    android:text="Citizen Community: Discussions &amp; Announcements"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnRewards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#D97706"
                    android:text="Civic Participation Points &amp; Badges [DEMO REWARDS]"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnEnvironmental"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#059669"
                    android:text="Environmental Services, Air Quality (AQI) &amp; Eco Care"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnCommunicationCenter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#0284C7"
                    android:text="Communication Center: Citizen Helplines &amp; Desks"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnNotificationCenter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#1E3A8A"
                    android:text="Notification Center: History &amp; Municipal Alerts"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnJobs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:layout_marginBottom="6dp"
                    android:backgroundTint="#312E81"
                    android:text="Local Jobs &amp; Career Opportunities [DEMO DATA]"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnMyJobApplications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:backgroundTint="#4338CA"
                    android:text="My Job Applications &amp; Status"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
