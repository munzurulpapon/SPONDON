<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ADMIN: JOB MANAGEMENT"
            android:textColor="#142B52"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Publish municipal positions and review candidate applications"
            android:textColor="#64748B"
            android:textSize="13sp" />

        <!-- Post New Job Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PUBLISH NEW JOB POSTING"
                android:textColor="#4338CA"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNewJobTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#F8FAFC"
                android:hint="Job Title (e.g. Traffic Systems Engineer)"
                android:padding="12dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNewJobCompany"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F8FAFC"
                android:hint="Company / Municipal Department"
                android:padding="12dp"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spNewJobCategory"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#F8FAFC" />

            <Spinner
                android:id="@+id/spNewJobType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#F8FAFC" />

            <EditText
                android:id="@+id/etNewJobSalary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F8FAFC"
                android:hint="Salary / Remuneration (e.g. ৳30,000 / month)"
                android:padding="12dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNewJobLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F8FAFC"
                android:hint="Location / Area (e.g. KDA Avenue, Khulna)"
                android:padding="12dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNewJobDeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F8FAFC"
                android:hint="Deadline (e.g. 2026-12-31)"
                android:padding="12dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNewJobDesc"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:background="#F8FAFC"
                android:gravity="top"
                android:hint="Job Description and Responsibilities..."
                android:padding="12dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNewJobReqs"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:background="#F8FAFC"
                android:gravity="top"
                android:hint="Candidate Requirements &amp; Qualifications..."
                android:padding="12dp"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPublishJob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="#4338CA"
                android:text="Publish Job Posting"
                android:textColor="#FFFFFF" />

        </LinearLayout>

        <!-- Citizen Applications Section -->
        <TextView
            android:id="@+id/tvAdminAppsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="SUBMITTED CANDIDATE APPLICATIONS"
            android:textColor="#142B52"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progressAdminApps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutAdminAppsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnBackManageJobs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Back to Admin Dashboard" />

    </LinearLayout>

</ScrollView>
