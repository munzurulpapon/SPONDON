<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EMERGENCY DETAILS"
            android:textColor="#142B52"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmergencyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Name:"
            android:textColor="#142B52"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvEmergencyPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Phone:"
            android:textColor="#142B52"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvEmergencyType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Emergency Type:"
            android:textColor="#142B52"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvEmergencyLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Location:"
            android:textColor="#142B52"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvEmergencyDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Description:"
            android:textColor="#142B52"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/tvEmergencyCurrentStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Current Status:"
            android:textColor="#C62828"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Update Emergency Status"
            android:textColor="#142B52"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spEmergencyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etEmergencyAdminNote"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="15dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Admin Note"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="14dp" />

        <Button
            android:id="@+id/btnUpdateEmergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Update Emergency Status" />

        <Button
            android:id="@+id/btnBackEmergencyDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Back" />

    </LinearLayout>

</ScrollView>
