<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="JOB APPLICATION FORM"
            android:textColor="#142B52"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvApplyJobHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Applying for: Position at Company"
            android:textColor="#4338CA"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="CANDIDATE PROFILE"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etApplicantName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:padding="14dp" />

        <EditText
            android:id="@+id/etApplicantEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:padding="14dp" />

        <EditText
            android:id="@+id/etApplicantPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:hint="Phone Number"
            android:inputType="phone"
            android:padding="14dp" />

        <EditText
            android:id="@+id/etApplicantEdu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:hint="Highest Education / Institution"
            android:inputType="textCapWords"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="QUALIFICATIONS &amp; EXPERIENCE"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etApplicantSkills"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Key skills, software/tools, previous relevant experience..."
            android:inputType="textMultiLine"
            android:padding="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="COVER NOTE / MESSAGE TO EMPLOYER"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etApplicantCover"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Briefly explain why you are interested in this position..."
            android:inputType="textMultiLine"
            android:padding="14dp" />

        <Button
            android:id="@+id/btnSubmitJobApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#4338CA"
            android:text="Submit Application"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnCancelJobApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancel" />

    </LinearLayout>

</ScrollView>
