<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F7FC"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EMERGENCY MANAGEMENT"
        android:textColor="#142B52"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEmergencyCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Total Emergencies: 0"
        android:textColor="#607087"
        android:textSize="15sp" />

    <ProgressBar
        android:id="@+id/progressEmergencies"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvNoEmergencies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="No Emergency Requests Found"
        android:textColor="#607087"
        android:textSize="16sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvEmergencies"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="15dp"
        android:divider="#DCE3ED"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnBackEmergencies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Back to Dashboard" />

</LinearLayout>
