<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Red Curved Hero Header (Reference Screen 7) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_sos_hero_curved"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/btnBackEmergency"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="Back"
                    android:src="@drawable/ic_arrow_back_white" />
            </RelativeLayout>

            <!-- Beacon Radiating Icon -->
            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="6dp"
                android:contentDescription="Emergency Beacon"
                android:src="@drawable/ic_emergency_sos_red"
                android:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.08"
                android:text="SOS"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Emergency Request"
                android:textColor="#FEE2E2"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Main Body Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Advisory Text (Reference Screen 7) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Your location will be shared with emergency services."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Current Location Card (Reference Screen 7) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:contentDescription="Location Pin"
                    android:src="@drawable/ic_location_pin_blue" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Current Location"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLiveAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Khulna, Bangladesh"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvLiveGpsCoords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="GPS: 22.8456° N, 89.5403° E"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRefreshGps"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_button_secondary"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Refresh"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnAutoFillLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Primary Action: Send Emergency Alert (Reference Screen 7) -->
            <Button
                android:id="@+id/btnSubmitEmergency"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_danger"
                android:text="Send Emergency Alert"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Contact Buttons: Add Contact & Import from Phone (Reference Screen 7) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAddEmergencyContact"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_secondary"
                    android:text="Add Contact"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnImportPhoneContact"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_button_secondary"
                    android:text="Import Contacts"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Container for Trusted Emergency Contacts -->
            <LinearLayout
                android:id="@+id/layoutContactsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- Direct Hotlines Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Direct Emergency Hotlines"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="12dp">

                <Button
                    android:id="@+id/btnCall999"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_button_danger"
                    android:text="📞  CALL 999 (National Emergency)"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCallFire"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:text="🚒 Fire (16163)"
                        android:textAllCaps="false"
                        android:textColor="@color/emergency_red"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCallAmbulance"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_button_secondary"
                        android:text="🚑 Ambulance (16263)"
                        android:textAllCaps="false"
                        android:textColor="@color/primary_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Detailed Emergency Broadcast Form (Preserved for municipal registry) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Incident Details"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emergency Type"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spEmergencyType"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_edit_text" />

                <EditText
                    android:id="@+id/etEmergencyName"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Your Full Name"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEmergencyPhone"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Your Contact Phone Number"
                    android:inputType="phone"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEmergencyLocation"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edit_text"
                    android:hint="Current Location or Address"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etEmergencyDescription"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_edit_text"
                    android:gravity="top|start"
                    android:hint="Situation description..."
                    android:padding="10dp"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnViewMyEmergencies"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_secondary"
                android:text="View My Past Emergency Requests"
                android:textAllCaps="false"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Skyline Vector Illustration at Bottom -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:contentDescription="Skyline"
                android:scaleType="fitXY"
                android:src="@drawable/bg_city_skyline_vector" />

        </LinearLayout>
    </LinearLayout>

</ScrollView>
