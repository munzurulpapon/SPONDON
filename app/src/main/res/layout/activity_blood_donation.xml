<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#B91C1C"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLOOD DONATION NETWORK"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Find voluntary blood donors and municipal blood bank contacts"
            android:textColor="#FEE2E2"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#991B1B"
            android:padding="4dp"
            android:text="[DEMO DIRECTORY - Emergency verification required with hospital blood banks]"
            android:textColor="#FEF08A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRegisterDonor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FFFFFF"
            android:text="+ Register as Voluntary Blood Donor"
            android:textColor="#B91C1C"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Blood Group Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E2E8F0"
        android:padding="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBgAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="All"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBgAPos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="A+"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBgANeg"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="A-"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBgBPos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="B+"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBgBNeg"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="B-"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBgOPos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="O+"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBgONeg"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="O-"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBgABPos"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="AB+"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnBgABNeg"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="AB-"
                android:textSize="12sp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Donors List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDonorsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Available Donors &amp; Blood Banks"
                android:textColor="#334155"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutDonorsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btnBackBlood"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Back to Dashboard" />

</LinearLayout>
