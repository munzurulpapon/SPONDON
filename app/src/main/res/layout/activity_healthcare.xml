<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#991B1B"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HEALTHCARE &amp; EMERGENCY DIRECTORY"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="City hospitals, 24/7 clinics, pharmacies and emergency medical hotlines"
            android:textColor="#FEE2E2"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#7F1D1D"
            android:padding="4dp"
            android:text="[DEMO DATA - Sample verified directory for city demonstration]"
            android:textColor="#FEF08A"
            android:textSize="11sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etSearchHealthcare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="10dp"
            android:hint="Search hospital, clinic, pharmacy..."
            android:padding="12dp"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Category Filters -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E2E8F0"
        android:padding="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHealthAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="All"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHealthHospitals"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Hospitals"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHealthClinics"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Clinics &amp; Diagnostics"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHealthPharmacies"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="24/7 Pharmacies"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnHealthHotlines"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Emergency Hotlines"
                android:textSize="12sp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Blood Network Banner Shortcut -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FEF2F2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Need voluntary blood donors?"
            android:textColor="#991B1B"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvBloodDonationLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Blood Donors Directory →"
            android:textColor="#DC2626"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Healthcare Facilities List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHealthCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Available Facilities"
                android:textColor="#334155"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNoHealthResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="No healthcare facilities match your criteria."
                android:textColor="#64748B"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutHealthContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <Button
        android:id="@+id/btnBackHealthcare"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Back to Dashboard" />

</LinearLayout>
