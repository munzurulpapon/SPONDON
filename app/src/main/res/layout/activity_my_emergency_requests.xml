<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F7FA">

    <TextView
        android:id="@+id/tvEmergencyHistoryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Emergency Requests"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#172B4D"
        android:padding="12dp" />

    <ProgressBar
        android:id="@+id/progressEmergencyHistory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvNoEmergencyHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No emergency requests found."
        android:textSize="16sp"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvEmergencyHistory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#CCCCCC"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btnBackEmergencyHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Dashboard" />

</LinearLayout>
