<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:orientation="vertical">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E3A8A"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOTIFICATION CENTER"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Municipal alerts, status updates &amp; announcements"
                    android:textColor="#DBEAFE"
                    android:textSize="12sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnMarkAllRead"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#FFFFFF"
                android:text="Read All"
                android:textColor="#1E3A8A"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Search Bar -->
        <EditText
            android:id="@+id/etSearchNotifications"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp"
            android:background="@android:drawable/editbox_background"
            android:hint="Search notifications..."
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="#1F2937"
            android:textColorHint="#9CA3AF"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Category Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#1E3A8A"
                android:text="All"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterUnread"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#E2E8F0"
                android:text="Unread"
                android:textColor="#1E293B"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterReports"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#E2E8F0"
                android:text="Civic Reports"
                android:textColor="#1E293B"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterProjects"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#E2E8F0"
                android:text="Public Projects"
                android:textColor="#1E293B"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFilterAlerts"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#E2E8F0"
                android:text="City Alerts"
                android:textColor="#1E293B"
                android:textSize="12sp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Sub-header bar: Count & Clear -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F1F5F9"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tvNotifSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Loading notifications..."
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnClearAllNotifs"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:backgroundTint="#EF4444"
            android:text="Clear History"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Notifications ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvNoNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="No notifications found in this category."
                android:textColor="#94A3B8"
                android:textSize="15sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutNotificationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="6dp"
        android:padding="12dp">

        <Button
            android:id="@+id/btnBackNotification"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:backgroundTint="#475569"
            android:text="Back to Citizen Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
