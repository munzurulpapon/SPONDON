package com.example.spondon;

import android.content.Intent;
import android.content.pm.PackageManager;
import android.os.Build;
import android.os.Bundle;
import android.view.View;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.TextView;

import androidx.appcompat.app.AppCompatActivity;
import androidx.core.app.ActivityCompat;
import androidx.core.content.ContextCompat;

import com.google.firebase.auth.FirebaseAuth;

public class DashboardActivity extends AppCompatActivity {

    private TextView tvRole;
    private LinearLayout layoutProviderWorkspace;

    private Button btnLogout;
    private Button btnProviderRequests;

    // 1. Smart Transportation
    private Button btnTransportation;

    // 2. SOS & Disaster Management
    private Button btnEmergency, btnDisasterManagement, btnMyEmergencyRequests;

    // 3. Public Utilities
    private Button btnPublicUtilities;

    // 4. Smart City Services
    private Button btnServicesDirectory, btnMyServiceRequests;

    // 5. Healthcare & Public Facilities
    private Button btnHealthcare, btnBloodDonation;

    // 6. Tourism & Important Places
    private Button btnTourism;

    // 7. Jobs & Opportunities
    private Button btnJobs, btnMyJobApplications;

    // 8. Vehicle & Road Services
    private Button btnVehicleRoad;

    // 9. Civic Reporting & Map
    private Button btnReportIssue, btnMyReports;
    private Button btnCityMap;

    // 10. Public Municipal Projects
    private Button btnPublicProjects;

    // 11. Citizen Community & Rewards
    private Button btnCommunity, btnRewards;

    // 12. Environmental Services
    private Button btnEnvironmental;

    // 13. Communication & Notification Centers
    private Button btnCommunicationCenter, btnNotificationCenter;

    // City Intelligence Dashboard
    private Button btnCityIntelligence;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        // Register FCM Token for notifications
        MyFirebaseMessagingService.registerToken(this);
        requestNotificationPermission();

        String role = getIntent().getStringExtra("USER_ROLE");
        if (role == null) {
            role = "Citizen";
        }

        // Admin Dashboard redirection if user has Admin role
        if ("Admin".equals(role)) {
            Intent intent = new Intent(DashboardActivity.this, AdminDashboardActivity.class);
            startActivity(intent);
            finish();
            return;
        }

        setContentView(R.layout.activity_dashboard);

        // Realtime Database: mark user online (auto-offline on disconnect)
        RealtimeDbHelper.goOnline(role);

        tvRole = findViewById(R.id.tvRole);
        btnLogout = findViewById(R.id.btnLogout);
        layoutProviderWorkspace = findViewById(R.id.layoutProviderWorkspace);
        btnProviderRequests = findViewById(R.id.btnProviderRequests);

        // 1. Transportation
        btnTransportation = findViewById(R.id.btnTransportation);

        // 2. SOS & Disaster Management
        btnEmergency = findViewById(R.id.btnEmergency);
        btnDisasterManagement = findViewById(R.id.btnDisasterManagement);
        btnMyEmergencyRequests = findViewById(R.id.btnMyEmergencyRequests);

        // 3. Public Utilities
        btnPublicUtilities = findViewById(R.id.btnPublicUtilities);

        // 4. Services
        btnServicesDirectory = findViewById(R.id.btnServicesDirectory);
        btnMyServiceRequests = findViewById(R.id.btnMyServiceRequests);

        // 5. Healthcare
        btnHealthcare = findViewById(R.id.btnHealthcare);
        btnBloodDonation = findViewById(R.id.btnBloodDonation);

        // 6. Tourism
        btnTourism = findViewById(R.id.btnTourism);

        // 7. Jobs
        btnJobs = findViewById(R.id.btnJobs);
        btnMyJobApplications = findViewById(R.id.btnMyJobApplications);

        // 8. Vehicle & Road
        btnVehicleRoad = findViewById(R.id.btnVehicleRoad);

        // 9. Civic Reporting & Map
        btnReportIssue = findViewById(R.id.btnReportIssue);
        btnMyReports = findViewById(R.id.btnMyReports);
        btnCityMap = findViewById(R.id.btnCityMap);

        // 10. Infrastructure
        btnPublicProjects = findViewById(R.id.btnPublicProjects);

        // 11. Citizen Community & Rewards
        btnCommunity = findViewById(R.id.btnCommunity);
        btnRewards = findViewById(R.id.btnRewards);

        // 12. Environmental Services
        btnEnvironmental = findViewById(R.id.btnEnvironmental);

        // 13. Communication & Notification Centers
        btnCommunicationCenter = findViewById(R.id.btnCommunicationCenter);
        btnNotificationCenter = findViewById(R.id.btnNotificationCenter);
        btnCityIntelligence = findViewById(R.id.btnCityIntelligence);

        tvRole.setText(role + " Dashboard");

        // Service Provider workspace visibility
        if ("Service Provider".equalsIgnoreCase(role)) {
            layoutProviderWorkspace.setVisibility(View.VISIBLE);
            btnProviderRequests.setOnClickListener(v -> {
                startActivity(new Intent(DashboardActivity.this, ProviderRequestsActivity.class));
            });
        } else {
            layoutProviderWorkspace.setVisibility(View.GONE);
        }

        // Logout
        btnLogout.setOnClickListener(v -> logout());

        // 1. Smart Transportation
        btnTransportation.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, TransportationActivity.class));
        });

        // 2. SOS & Disaster Management
        btnEmergency.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, EmergencyRequestActivity.class));
        });

        btnDisasterManagement.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, DisasterManagementActivity.class));
        });

        btnMyEmergencyRequests.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, MyEmergencyRequestsActivity.class));
        });

        // 3. Public Utilities
        btnPublicUtilities.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, PublicUtilitiesActivity.class));
        });

        // 4. Smart City Services Directory
        btnServicesDirectory.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, ServicesActivity.class));
        });

        btnMyServiceRequests.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, MyServiceRequestsActivity.class));
        });

        // 5. Healthcare Facilities & Blood Network
        btnHealthcare.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, HealthcareActivity.class));
        });

        btnBloodDonation.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, BloodDonationActivity.class));
        });

        // 6. Smart Tourism & Heritage
        btnTourism.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, TourismActivity.class));
        });

        // 7. Jobs & Opportunities
        btnJobs.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, JobsActivity.class));
        });

        btnMyJobApplications.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, MyJobApplicationsActivity.class));
        });

        // 8. Vehicle & Road Services
        btnVehicleRoad.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, VehicleRoadActivity.class));
        });

        // 9. Civic Issue Reporting & History
        btnReportIssue.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, ReportActivity.class));
        });

        btnMyReports.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, MyReportsActivity.class));
        });

        // City Map & Navigation
        btnCityMap.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, CityMapActivity.class));
        });

        // 10. Public Projects
        btnPublicProjects.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, PublicProjectsActivity.class));
        });

        // 11. Citizen Community & Rewards
        btnCommunity.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, CommunityActivity.class));
        });

        btnRewards.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, RewardsActivity.class));
        });

        // 12. Environmental Services
        btnEnvironmental.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, EnvironmentalActivity.class));
        });

        // 13. Communication & Notification Centers
        btnCommunicationCenter.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, CommunicationCenterActivity.class));
        });

        btnNotificationCenter.setOnClickListener(v -> {
            startActivity(new Intent(DashboardActivity.this, NotificationCenterActivity.class));
        });
    }

    private void logout() {
        RealtimeDbHelper.goOffline();
        FirebaseAuth.getInstance().signOut();
        Intent intent = new Intent(DashboardActivity.this, LoginActivity.class);
        intent.setFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
        startActivity(intent);
        finish();
    }

    private void requestNotificationPermission() {
        if (Build.VERSION.SDK_INT >= 33) {
            String postNotification = "android.permission.POST_NOTIFICATIONS";
            if (ContextCompat.checkSelfPermission(this, postNotification)
                    != PackageManager.PERMISSION_GRANTED) {
                ActivityCompat.requestPermissions(this,
                        new String[]{postNotification}, 101);
            }
        }
    }
}