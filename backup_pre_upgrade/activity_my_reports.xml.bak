<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/my_reports"
        android:textColor="#142B52"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Track all your submitted city complaints."
        android:textColor="#607087"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvReportCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Total Reports: 0"
        android:textColor="#142B52"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvEmptyReports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center"
        android:text="No reports submitted yet."
        android:textColor="#607087"
        android:textSize="16sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/lvReports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="15dp"
        android:layout_weight="1"
        android:divider="#DCE3ED"
        android:dividerHeight="10dp" />



    <EditText
        android:id="@+id/etSearchReports"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Search by title, category or location"
        android:padding="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:inputType="text" />

    <Spinner
        android:id="@+id/spReportStatusFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp" />


</LinearLayout>
