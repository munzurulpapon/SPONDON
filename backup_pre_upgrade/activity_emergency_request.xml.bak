<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EMERGENCY INFORMATION &amp; SOS"
            android:textColor="#DC2626"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Direct emergency hotlines, GPS location detection, trusted contacts and broadcast assistance."
            android:textColor="#475569"
            android:textSize="13sp" />

        <!-- Disclaimer Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FEF2F2"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ IMPORTANT NOTICE: Broadcasts an assistance alert to the municipal registry and your trusted contacts. It does NOT automatically dispatch national 999 emergency units. For urgent life threats, call 999 directly below."
                android:textColor="#991B1B"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Direct Emergency Hotlines -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FEE2E2"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DIRECT EMERGENCY HOTLINES"
                android:textColor="#991B1B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCall999"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#DC2626"
                android:text="CALL 999 (National Emergency - Police/Fire/Ambulance)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCallFire"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#B91C1C"
                    android:text="FIRE (16163)"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnCallAmbulance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#047857"
                    android:text="HEALTH (16263)"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Live GPS Location Display Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT GPS LOCATION &amp; COORDINATES"
                android:textColor="#1E293B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLiveGpsCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="GPS: Detecting current position..."
                android:textColor="#0284C7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLiveAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Address: Acquiring reverse-geocoded location..."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRefreshGps"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#0284C7"
                    android:text="Refresh GPS"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnAutoFillLocation"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#0F766E"
                    android:text="Use in Form"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Trusted Emergency Contacts Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TRUSTED EMERGENCY CONTACTS"
                    android:textColor="#1E293B"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAddEmergencyContact"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="#4F46E5"
                    android:text="+ Add Contact"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Saved locally on this device for quick emergency dialing."
                android:textColor="#64748B"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/layoutContactsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- SOS Request Form Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="BROADCAST EMERGENCY DISPATCH REQUEST"
            android:textColor="#1E293B"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Saved in your local history and logged to the municipal emergency response registry."
            android:textColor="#64748B"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etEmergencyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:hint="Your Full Name"
            android:inputType="textCapWords"
            android:padding="13dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etEmergencyPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:hint="Contact Phone Number"
            android:inputType="phone"
            android:padding="13dp"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Emergency Type"
            android:textColor="#1E293B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spEmergencyType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FFFFFF"
            android:padding="12dp" />

        <EditText
            android:id="@+id/etEmergencyLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:hint="Incident Location / Address"
            android:inputType="textCapSentences"
            android:padding="13dp"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etEmergencyDescription"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Describe the Emergency Situation"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="13dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSubmitEmergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="#DC2626"
            android:text="SUBMIT EMERGENCY DISPATCH REQUEST"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnViewMyEmergencies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#475569"
            android:text="View My Submitted Emergency Requests"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnBackEmergency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Back to Dashboard" />

    </LinearLayout>

</ScrollView>
